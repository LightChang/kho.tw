---
// 主題分類索引。主題講的是課程內容，與「類型」（開課單位的性質）是兩個獨立面向（見 src/lib/data.mjs）。
import Base from '../layouts/Base.astro';
import { getData, fmt } from '../lib/data.mjs';
import { pageListJsonLd, SITE_URL } from '../../site/jsonld.mjs';

const { courses, topics, categorised } = getData();
const topicUrl = (name) => `${SITE_URL}/topic/${encodeURIComponent(name)}.html`;
---
<Base
  title="課程主題分類"
  description={`語言、電腦資訊、運動健身、料理烘焙等 ${topics.length} 類成人課程主題索引，共 ${fmt(categorised)} 門課。`}
  canonical={`${SITE_URL}/topics.html`}
  jsonld={pageListJsonLd(topics.map((t) => ({ url: topicUrl(t.name), name: t.name })), { name: '課程主題分類' })}
>
<div class="card"><h2>主題分類</h2><div class="meta">想學什麼就從這裡找。數字是該主題正在招生／全部的課程數。</div>
<div class="meta-2">全站 {fmt(courses.length)} 門課中有 {fmt(categorised)} 門已歸類；主題分類講的是課程內容，開課單位的性質請看<a href="/types.html">類型</a>。</div></div>
<div class="card"><ul class="chips">{topics.map((t) => <li><a href={`/topic/${encodeURIComponent(t.name)}.html`}>{t.name}<span class="n tnum">{fmt(t.open)}／{fmt(t.list.length)}</span></a></li>)}</ul></div>
</Base>
