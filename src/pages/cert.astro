---
// 證照班：課名寫明考照、檢定，或描述講到輔導報考技術士、證照的課（判斷規則見 src/lib/facets.mjs 的 isCert）。
import Base from '../layouts/Base.astro';
import CourseList from '../components/CourseList.astro';
import VenueSummary from '../components/VenueSummary.astro';
import { getData, fmt, certHref } from '../lib/data.mjs';
import { itemListJsonLd, SITE_URL } from '../../site/jsonld.mjs';

const { cert } = getData();
---
<Base
  title="證照班・檢定輔導課程｜丙級、乙級技術士與職訓考照課程"
  description={`全台可考證照的成人課程共 ${fmt(cert.list.length)} 門，其中 ${fmt(cert.open)} 門招生中，含丙級、乙級技術士檢定輔導、堆高機、照顧服務員、日語檢定等，依縣市整理。`}
  canonical={`${SITE_URL}${certHref()}`}
  jsonld={itemListJsonLd(cert.list.slice(0, 100), { name: '證照班・檢定輔導課程' })}
>
<div class="card"><h1>證照班・檢定輔導課程</h1>
<div class="meta">全台 {fmt(cert.list.length)} 門，其中 {fmt(cert.open)} 門招生中</div>
<div class="meta-2">收錄課名寫明證照、檢定、丙級／乙級、技術士、考照的課，以及課程說明寫到「輔導報考」「取得」某項證照或技能檢定的課。只寫「結業證書」「研習證明」的不算。能不能報考、考不考得過，以開課單位與考試主管機關公告為準。</div></div>
{cert.cities.length > 0 && (
<div class="card"><h3>依縣市</h3>
<ul class="chips">{cert.cities.map((x) => <li><a href={certHref(x.city)}>{x.city}<span class="n tnum">{fmt(x.open)}／{fmt(x.list.length)}</span></a></li>)}</ul></div>
)}
<VenueSummary list={cert.list} />
<CourseList list={cert.list} />
</Base>
