---
import Base from '../../layouts/Base.astro';
import { underSection } from '../../lib/crumbs.mjs';
import CourseList from '../../components/CourseList.astro';
import CityFacts from '../../components/CityFacts.astro';
import { getData, fmt, link, learnHref, certHref, isOpen, hasEnded, TODAY } from '../../lib/data.mjs';
import { cityFacts, soonestOpen, KID_TITLE } from '../../lib/city-facts.mjs';
import { itemListJsonLd, pageListJsonLd, SITE_URL } from '../../../site/jsonld.mjs';

export function getStaticPaths() {
  return getData().cities.map((c) => ({ params: { city: c.name }, props: { c } }));
}

const { c } = Astro.props;

// 機構類型分布：直接從這個縣市的課程清單聚合，不是另外杜撰的分類——
// 讓標題與說明能對上「台北 社大 課程」「台北 運動中心 課程」這種地域＋類型的實際問法。
const KIND_LABEL = new Map(getData().types.map((k) => [k.kind, k.label]));
const byKind = [...c.list.reduce((m, course) => {
  const kind = course.provider?.kind;
  if (kind) m.set(kind, (m.get(kind) ?? 0) + 1);
  return m;
}, new Map())].sort((a, b) => b[1] - a[1]);
const { learnByCity, learnByName, cert, newestOpenByCity, firstSeen, hubLinksOf, cityHubOf, free, senior } = getData();
// 縣市頁是樞紐（2026-10-02 起）：先回答、再分行政區與細項往 /learn/ 走。
// 2026-11-21 改版：頂端加「先看重點」（src/lib/city-facts.mjs）；66 個細項標籤改成「招生中最多的前 ACT_MAX 項＋開最多的行政區」表格；
// 原本 30 張依開課日倒排的課程卡（最前面是明年二月的兒童寒假營）改成「最近開課、還能報名」。
const ACT_MAX = 15;
const SOON_MAX = 12;
const VENUE_MAX = 12;
const hub = cityHubOf(c.name);
const hubs = hubLinksOf(c.name);
const fresh = (newestOpenByCity.get(c.name) ?? []).filter((o) => !KID_TITLE.test(o.title ?? '')).slice(0, 6);
const acts = learnByCity.get(c.name) ?? [];
const certCity = cert.cities.find((x) => x.city === c.name);
const topKinds = byKind.slice(0, 3).map(([kind]) => KIND_LABEL.get(kind)).filter(Boolean);
const f = cityFacts({ list: c.list, isOpen, hasEnded, today: TODAY, kindLabel: KIND_LABEL });
const soon = soonestOpen(c.list, { isOpen, today: TODAY, max: SOON_MAX });
const hubByDistrict = new Map(hub.districts.map((d) => [d.district, d]));
// 細項表：招生中多的在前；每一項附這個縣市裡開最多的行政區（有 /learn/ 行政區頁的才列）
const actRows = [...acts].sort((a, b) => b.open - a.open || b.n - a.n).map((o) => ({
  ...o,
  districts: (learnByName.get(o.activity.name)?.districts ?? []).filter((x) => x.city === c.name).slice(0, 3),
}));
const mainActs = actRows.slice(0, ACT_MAX);
const restActs = actRows.slice(ACT_MAX);
const freeLink = free.cities.some((x) => x.city === c.name) ? hubs.find((h) => h.text === `${c.name}免費課程`)?.href : null;
const seniorLink = senior.cities.some((x) => x.city === c.name) ? hubs.find((h) => h.text === `${c.name}銀髮・樂齡課程`)?.href : null;
// JSON-LD：/city/ 頁型一定要有 ItemList（site/validate-jsonld.mjs），itemListJsonLd 要 3 門以上才輸出。
// 近期開課的課夠 3 門就用它；不夠就用下方退回清單（依報名狀態的前 30 門）；連課都不到 3 門，改列本頁連出去的站內頁面。
const SHOW_ALL = soon.length < 3;
const jsonld = (!SHOW_ALL && itemListJsonLd(soon, { name: `${c.name}最近開課、還能報名的成人課程` }))
  || itemListJsonLd(c.list.slice(0, 30), { name: `${c.name}的成人課程` })
  || pageListJsonLd([
    ...acts.map((o) => ({ url: `${SITE_URL}${learnHref(o.activity.name, c.name)}`, name: `${c.name}${o.activity.label}課程` })),
    ...hubs.map((h) => ({ url: `${SITE_URL}${h.href}`, name: h.text })),
    { url: `${SITE_URL}/cities.html`, name: '各縣市成人課程' },
    { url: `${SITE_URL}/open.html`, name: '現在可報名的課程' },
    { url: `${SITE_URL}/search.html`, name: '搜尋課程' },
  ], { name: `${c.name}成人課程的相關頁面` });
const topDistrictNames = f.districts.filter((d) => d.open > 0).slice(0, 3).map((d) => d.district);
---
<Base crumbs={underSection('cities', c.name)}
  title={topKinds.length ? `${c.name}成人課程｜${topKinds.join('・')}` : `${c.name}的成人課程`}
  description={`${c.name}現在 ${fmt(f.openN)} 門成人課程招生中${f.notStarted > 0 ? `，${fmt(f.notStarted)} 門還沒開課` : ''}${topDistrictNames.length ? `；招生中最多在${topDistrictNames.join('、')}` : ''}。${byKind.slice(0, 3).map(([kind, n]) => `${KIND_LABEL.get(kind)}${fmt(n)}門`).join('、')}，共 ${fmt(c.list.length)} 門，附上課時段、費用與各區細項。`}
  canonical={`${SITE_URL}/city/${encodeURIComponent(c.name)}.html`}
  jsonld={jsonld}
>
<div class="card"><h1>{c.name}成人課程</h1><div class="meta">{fmt(c.list.length)} 門課，其中 {fmt(f.openN)} 門招生中</div>
{byKind.length > 0 && (
<ul class="chips">{byKind.map(([kind, n]) => (
  <li><a href={link('type', kind)}>{KIND_LABEL.get(kind) ?? kind}<span class="n">{fmt(n)}</span></a></li>
))}</ul>
)}
</div>
<CityFacts f={f} city={c.name} acts={acts} today={TODAY} freeHref={freeLink} seniorHref={seniorLink} />
{mainActs.length > 0 && (
<div class="card"><h2>{c.name}想學什麼</h2>
<div class="meta-2">依招生中的課數排列。細項連到{c.name}的整理頁，行政區連到該區的同類課。</div>
<table><tr><th>細項</th><th>招生中</th><th>開最多的行政區</th></tr>
{mainActs.map((o) => (
<tr><td><a href={learnHref(o.activity.name, c.name)}>{o.activity.label}</a></td><td class="tnum">{fmt(o.open)}<div class="meta-2">共 {fmt(o.n)}</div></td>
<td>{o.districts.length > 0 ? o.districts.map((x, i) => <Fragment>{i > 0 && '、'}<a href={learnHref(o.activity.name, x.area)}>{x.district}</a> <span class="meta-2 tnum">{fmt(x.list.length)}</span></Fragment>) : <span class="meta-2">各區都不到 10 門，課列在{c.name}整理頁</span>}</td></tr>
))}
</table>
{restActs.length > 0 && (
<Fragment><div class="meta-2">其他細項（招生中／全部）：</div>
<ul class="chips">{restActs.map((o) => <li><a href={learnHref(o.activity.name, c.name)}>{o.activity.label}<span class="n tnum">{fmt(o.open)}／{fmt(o.n)}</span></a></li>)}</ul></Fragment>
)}
{certCity && <div class="meta-2"><a href={certHref(c.name)}>{c.name}證照班 {fmt(certCity.list.length)} 門</a></div>}
</div>
)}
{hubs.length > 0 && (
<div class="card"><h3>{c.name}專題</h3>
<ul class="chips">{hubs.map((h) => <li><a href={h.href}>{h.text}<span class="n tnum">{fmt(h.n)}</span></a></li>)}</ul></div>
)}
{f.districts.length > 0 && (
<div class="card"><h2>{c.name}各行政區</h2>
<div class="meta-2">依招生中的課數排列。細項連到該區的課程整理，地點連到課程表。</div>
<table><tr><th>行政區</th><th>招生中</th><th>熱門課程與上課地點</th></tr>
{f.districts.map((d) => {
  const h = hubByDistrict.get(d.district);
  return (
<tr id={`d-${d.district}`}><td>{d.district}</td><td class="tnum">{fmt(d.open)}<div class="meta-2">共 {fmt(d.n)}</div></td><td>
{h && h.learn.length > 0 && <div>{h.learn.slice(0, 6).map((o, i) => <Fragment>{i > 0 && '、'}<a href={learnHref(o.activity.name, o.area)}>{o.activity.label}</a></Fragment>)}</div>}
{h && h.venues.length > 0 && <div class="meta-2">{h.venues.slice(0, 3).map((r, i) => <Fragment>{i > 0 && '、'}<a href={link('venue', r.venue.slug)}>{r.display.heading}</a></Fragment>)}{h.venues.length > 3 && `等 ${fmt(h.venues.length)} 個地點`}</div>}
</td></tr>
  );
})}
</table></div>
)}
{soon.length > 0 && (
<Fragment>
<div class="card"><h2>{c.name}最近開課、還能報名</h2>
<div class="meta-2">招生中、開課日在今天以後的課，開課日近的在前。同一門課的不同場次只列一次，同一個開課單位最多兩門，兒童、親子課不列。全部招生中的課見<a href="/open.html">可報名</a>，找特定課名用<a href="/search.html">搜尋</a>。</div></div>
<CourseList list={soon} max={SOON_MAX} />
</Fragment>
)}
{SHOW_ALL && c.list.length > 0 && (
<Fragment>
<div class="card"><h2>{c.name}的課程</h2>
<div class="meta-2">{soon.length > 0 ? `還沒開課的招生中課程只有上面 ${soon.length} 門，` : '目前沒有還沒開課的招生中課程，'}下面依報名狀態列出{c.list.length > 30 ? '前 30 門' : `全部 ${fmt(c.list.length)} 門`}，上完的課排在最後。</div></div>
<CourseList list={c.list} max={30} />
</Fragment>
)}
{fresh.length > 0 && (
<div class="card"><h3>{c.name}最近新上架</h3>
{fresh.map((o) => <div><a href={link('course', o.slug)}>{o.title}</a> <span class="meta-2">{o.provider?.nameRaw ?? ''}・{String(firstSeen.get(o.id)).slice(5).replace('-', '/')} 收錄</span></div>)}
</div>
)}
{hub.venues.length > 0 && (
<div class="card"><h3>{c.name}主要上課地點</h3>
<table><tr><th>地點</th><th>行政區</th><th>還沒上完</th></tr>
{hub.venues.slice(0, VENUE_MAX).map((r) => <tr><td><a href={link('venue', r.venue.slug)}>{r.display.heading}</a></td><td class="meta-2">{r.venue.district ?? ''}</td><td class="tnum">{fmt(r.current)}<div class="meta-2">共 {fmt(r.n)}</div></td></tr>)}
</table>
{hub.venues.length > VENUE_MAX && <div class="meta-2">另有 {fmt(hub.venues.length - VENUE_MAX)} 個地點，見<a href="/map.html">地圖</a>或上方行政區。</div>}
</div>
)}
</Base>
