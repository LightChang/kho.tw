---
// 搜尋頁：純前端，讀 /index.json（transform/emit.mjs 產出、由 public/ 複製過來）。
//
// 查詢字一律放進網址（/search.html?q=瑜珈）：
//   1. 表單本身就是 GET、欄位名 q，沒有 JavaScript 也會帶著 ?q= 重新載入這一頁
//   2. 有 JavaScript 時攔下送出、原地搜尋，但用 history.pushState 把 ?q= 寫回網址——
//      GA4 加強型評估的「網站搜尋」靠網址上的 q 參數認出搜尋（view_search_results），
//      先前原地搜尋不改網址，28 天只記到 2 次。
//   3. 另外送一個 GA4 建議事件 search（search_term），不依賴加強型評估的設定。
// 首頁的 JSON-LD SearchAction 也是指向 /search.html?q=，三者用同一個參數名。
import Base from '../layouts/Base.astro';
import { SITE_URL } from '../../site/jsonld.mjs';
---
<Base title="搜尋課程" description="在 29,000 門全台成人課程中搜尋課名、單位或講師。" canonical={`${SITE_URL}/search.html`}>
<div class="card"><h1>搜尋</h1>
<form id="f" role="search" class="search-form" action="/search.html" method="get">
<input id="q" name="q" type="search" placeholder="課名、單位、講師" aria-label="搜尋課名、單位、講師">
<button>搜尋</button></form>
<div class="meta search-count" id="n">載入索引中⋯</div></div>
<div id="r"></div>
<script is:inline>
const L={open:'招生中',upcoming:'尚未開放報名',full:'額滿',running:'開課中',closed:'報名已截止',cancelled:'停開',unknown:'狀態未知'};
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let idx=[];
function track(v,n){
  // GA 沒啟用時（本機、KHO_GA_ID 未設）window.gtag 不存在，直接略過
  if(typeof window.gtag==='function')window.gtag('event','search',{search_term:v,results:n});
}
(async()=>{idx=await(await fetch('/index.json')).json();
  document.getElementById('n').textContent='共 '+idx.length.toLocaleString('en-US')+' 門課可搜尋';
  const p=(new URLSearchParams(location.search).get('q')||'').trim();
  if(p){document.getElementById('q').value=p;run(p)}})();
function run(v){
  const hit=idx.filter(r=>r[1].includes(v)||r[9].includes(v)||(r[10]||'').includes(v)||(r[11]||'').includes(v));
  document.getElementById('n').textContent='找到 '+hit.length.toLocaleString('en-US')+' 門課'+(hit.length>200?'（顯示前 200）':'');
  document.getElementById('r').innerHTML=hit.slice(0,200).map(r=>
    '<div class="card"><div><a href="/course/'+encodeURIComponent(r[0])+'.html">'+esc(r[1])+'</a> <span class="st st-'+esc(r[6])+'">'+esc(L[r[6]]||r[6])+'</span></div>'+
    '<div class="meta">'+esc(r[9])+(r[2]?'　'+esc(r[2])+esc(r[3]||''):'')+'</div></div>').join('');
  track(v,hit.length);
}
document.getElementById('f').addEventListener('submit',e=>{
  e.preventDefault();
  const v=document.getElementById('q').value.trim();
  if(!v)return;
  const url=location.pathname+'?q='+encodeURIComponent(v);
  // 同一個字重按不再疊一筆瀏覽紀錄
  if(new URLSearchParams(location.search).get('q')!==v)history.pushState({q:v},'',url);
  run(v);
});
window.addEventListener('popstate',()=>{
  const v=(new URLSearchParams(location.search).get('q')||'').trim();
  document.getElementById('q').value=v;
  if(v&&idx.length)run(v);else document.getElementById('r').innerHTML='';
});
</script>
</Base>
