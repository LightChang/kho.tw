---
import Base from '../../layouts/Base.astro';
import CourseList from '../../components/CourseList.astro';
import { getData, fmt } from '../../lib/data.mjs';
import { itemListJsonLd, SITE_URL } from '../../../site/jsonld.mjs';

export function getStaticPaths() {
  return getData().topics.map((t) => ({ params: { name: t.name }, props: { t } }));
}

const { t } = Astro.props;
---
<Base
  title={`${t.name}課程`}
  description={`全台${t.name}類成人課程共 ${fmt(t.list.length)} 門，其中 ${fmt(t.open)} 門招生中。`}
  canonical={`${SITE_URL}/topic/${encodeURIComponent(t.name)}.html`}
  jsonld={itemListJsonLd(t.list.slice(0, 100), { name: `${t.name}課程` })}
>
<div class="card"><h2>{t.name}</h2><div class="meta">{fmt(t.list.length)} 門課，其中 {fmt(t.open)} 門招生中</div>
{t.inferred > 0 && <div class="meta-2">其中 {fmt(t.inferred)} 門是依課名判斷的分類（來源沒標分類、或標的是行政分類），卡片上會註明。</div>}</div>
<CourseList list={t.list} markInferred />
</Base>
