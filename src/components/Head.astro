---
// <head> 的共用內容。樣式不在這裡：內頁由 Base.astro 連外部 CSS，首頁自己內嵌。
import { ANALYTICS, GSC_VERIFY } from '../site.config.mjs';
import { breadcrumbJsonLd } from '../../site/jsonld.mjs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonld?: object;
  robots?: string;
  crumbs?: { name: string; href?: string }[];
}
const { title, description, canonical, jsonld, robots, crumbs } = Astro.props;
// 全站唯一的 JSON-LD 出口：頁面自己的那塊（site/jsonld.mjs 產生）＋麵包屑，各一個 script。
// JSON-LD 內的 < 一律跳脫成 \u003c，否則字串裡若出現 </script> 會提前結束 script 區塊
// （HTML 規範；Astro 的 set:html 不跳脫。見 rules.json 的 global.scriptContent、global.astroOutput）
const lds = [jsonld, breadcrumbJsonLd(crumbs)].filter(Boolean)
  .map((o) => JSON.stringify(o).replace(/</g, '\\u003c'));
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
{/* 站徽（public/favicon.svg）：一扇門，門把是「招生中」的綠點。
    三種格式：.ico 給不支援 SVG 的舊瀏覽器（也是它們自動去要 /favicon.ico 時的目標）、
    .svg 給現行瀏覽器（支援時一律優先用它）、.png 給 iOS 加到主畫面。
    .ico 是 32px PNG 包進 ICO 容器，重做方式見 docs/pipeline.md 的站徽一節。 */}
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#1e5ab8">
{/* 官方要求 GA 放在 <head> 開啟標籤之後立刻，所以排在 charset/viewport 之後、title 之前 */}
<Fragment set:html={ANALYTICS} />
<title>{title}</title>
{description && <meta name="description" content={description}>}
{robots && <meta name="robots" content={robots}>}
{canonical && <link rel="canonical" href={canonical}>}
{lds.map((ld) => <script type="application/ld+json" is:inline set:html={ld} />)}
{GSC_VERIFY && <meta name="google-site-verification" content={GSC_VERIFY}>}
