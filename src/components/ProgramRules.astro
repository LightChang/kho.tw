---
// 職訓方案的資格與補助說明。每一句都出自法規原文（勞動部勞動法令查詢系統），附條號與連結；
// 法規改了就改這裡，查證日期一併更新。課程資料本身不帶時數與費用，這裡不替來源補數字。
const { programKey } = Astro.props;
const RULES = {
  '產投': {
    law: '產業人才投資方案補助要點', amended: '民國 113 年 12 月 25 日修正',
    url: 'https://laws.mol.gov.tw/FLAW/FLAWDAT0202.aspx?id=FL041561',
    lines: [
      '對象：年滿 15 歲、具就業保險、勞工保險、勞工職業災害保險或農民健康保險被保險人身分的在職勞工（第二點）。',
      '補助：依訓練單位收費標準補助每位學員 50% 至 80% 訓練費用，其餘自付；三年內最高補助新臺幣 10 萬元（第四點）。',
      '獨力負擔家計者、中高齡者、身心障礙者、原住民、低收入戶或中低收入戶中有工作能力者、逾 65 歲之高齡者等身分，補助全額訓練費用（第四點）。',
    ],
  },
  '職前訓練': {
    law: '失業者職業訓練實施基準', amended: '民國 115 年 1 月 14 日修正',
    url: 'https://laws.mol.gov.tw/FLAW/FLAWDAT0202.aspx?id=FL089894',
    lines: [
      '對象：年滿 15 歲、具工作意願且工作技能不足的失業者；在職勞工、自營作業者、公司或行號負責人不能報名（第四點）。',
      '費用：學員原則上自付該班核定個人訓練費的 20%；參加分署自辦課程，或檢具特定失業者身分證明文件者，免費參訓（第十二點）。',
    ],
  },
};
const r = RULES[programKey];
---
{r && (
<div class="card"><h3>誰能報、補助多少</h3>
<ul>{r.lines.map((t) => <li>{t}</li>)}</ul>
<div class="meta-2">出處：<a href={r.url} rel="noopener">{r.law}</a>（{r.amended}，2026-09-28 查證）。每門課的時數、費用與自付額，本站資料來源沒有提供，請看課程頁連到的報名頁面；個人資格以勞動部勞動力發展署審核為準。</div>
</div>
)}
