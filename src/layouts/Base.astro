---
// 內頁共用版型：頁首導覽 ＋ .wrap 主欄。
//
// 樣式走外部檔（build.inlineStylesheets: 'never'）：共用 CSS 內嵌在四萬多頁等於 193 MB，
// 佔 dist 總量的四成，而且每一頁都讓讀者重下載一次。首頁不用這個版型，理由見 index.astro。
import '../styles/site.css';
import Head from '../components/Head.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonld?: object;
}
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <Head {...Astro.props} />
  <slot name="head" />
</head>
<body>
<header class="topbar"><div class="inner"><b><a href="/">kho.tw</a></b>
<a href="/open.html">可報名</a><a href="/topics.html">主題</a><a href="/types.html">類型</a><a href="/cities.html">縣市</a><a href="/map.html">地圖</a><a href="/teachers.html">講師</a><a href="/search.html">搜尋</a></div></header>
<main class="wrap"><slot /></main>
</body>
</html>
